{
    "name": "ai-gist",
    "version": "2.1.5",
    "buildRevision": 1,
    "description": "本地优先的移动端提示词管理工具，能够管理提示词 + 变量填充 + 分类标签。",
    "scripts": {
        "dev": "vite --config config/vite.config.mobile.js",
        "build": "node scripts/build-mobile.js",
        "build:web": "vite build --config config/vite.config.mobile.js",
        "preview:web": "vite preview --config config/vite.config.mobile.js",
        "cap:assets": "npx @capacitor/assets generate",
        "cap:sync": "cap sync",
        "cap:ios": "cap open ios",
        "cap:android": "cap open android",
        "lint": "eslint --config config/eslint.config.mjs .",
        "lint:fix": "eslint --config config/eslint.config.mjs . --fix",
        "test": "vitest --config config/vitest.config.ts",
        "test:run": "vitest run --config config/vitest.config.ts",
        "test:ui": "vitest --ui --config config/vitest.config.ts",
        "test:coverage": "vitest run --coverage --config config/vitest.config.ts",
        "version:sync": "node scripts/sync-version.js",
        "version:check": "node scripts/sync-version.js --check",
        "version": "node scripts/sync-version.js && git add -A",
        "postversion": "git push && git push --tags"
    },
    "repository": "https://github.com/msiya8160-star/AI-Gist-Tuji.git",
    "author": {
        "name": "Yarin Zhang",
        "url": "https://github.com/yarin-zhang"
    },
    "contributors": [
        "兔叽 (https://github.com/msiya8160-star)"
    ],
    "license": "AGPL-3.0-only",
    "devDependencies": {
        "@capacitor/android": "^8.1.0",
        "@capacitor/app": "^8.0.1",
        "@capacitor/assets": "^3.0.5",
        "@capacitor/camera": "^8.0.2",
        "@capacitor/cli": "^8.1.0",
        "@capacitor/core": "^8.1.0",
        "@capacitor/filesystem": "^8.1.2",
        "@capacitor/ios": "^8.1.0",
        "@capacitor/preferences": "^8.0.1",
        "@capacitor/share": "^8.0.1",
        "@capacitor/splash-screen": "^8.0.1",
        "@eslint/js": "^9.29.0",
        "@ionic/vue": "^8.0.0",
        "@ionic/vue-router": "^8.0.0",
        "@types/nunjucks": "^3.2.6",
        "@types/uuid": "^10.0.0",
        "@typescript-eslint/parser": "^8.35.0",
        "@vicons/tabler": "^0.13.0",
        "@vitejs/plugin-vue": "^4.4.1",
        "@vitest/coverage-v8": "~3.1.0",
        "@vitest/ui": "~3.1.0",
        "chalk": "^4.1.2",
        "eslint": "^9.29.0",
        "eslint-plugin-vue": "^10.2.0",
        "fake-indexeddb": "^6.2.5",
        "fast-check": "^4.9.0",
        "ionicons": "^7.0.0",
        "jsdom": "^24.1.0",
        "nunjucks": "^3.2.4",
        "sass": "^1.89.2",
        "typescript": "^5.8.3",
        "typescript-eslint": "^8.35.0",
        "vite": "^6.3.5",
        "vitest": "~3.1.0",
        "vue": "^3.3.8",
        "vue-eslint-parser": "^10.1.4",
        "vue-i18n": "9",
        "vue-router": "^4.0.0"
    },
    "dependencies": {
        "uuid": "^11.1.0"
    },
    "packageManager": "yarn@4.9.2"
}
